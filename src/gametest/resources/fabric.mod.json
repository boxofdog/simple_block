{
	"schemaVersion": 1,
	"id": "simple_block-gametest",
	"version": "0.0.0",
	"name": "Simple Block game tests",
	"environment": "*",
	"entrypoints": {
		"fabric-gametest": [
			"io.github.boxofdog.simpleblock.gametest.SleepGameTests",
